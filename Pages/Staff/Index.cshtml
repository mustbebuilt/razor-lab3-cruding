@page
@model MyRazorApp.Pages.Staff.IndexModel
@{
    ViewData["Title"] = "Staff Directory (Starter)";
}

<div class="page-hero hero-blue">
    <div style="display: flex; align-items: center; gap: 0.5rem; margin-bottom: 0.5rem;">
        <span class="step-pill pill-teal">Step 06 &amp; 08</span>
        <span class="step-pill pill-amber">Starter Exercise</span>
    </div>
    <h1>Staff Directory</h1>
    <p class="lead">
        This is the target page for your database query exercises. Right now, this is a starter placeholder. In <strong>Step 06</strong>, you will connect your SQLite database and display live staff records here.
    </p>
</div>

<div class="alert alert-warning">
    <strong>⚡ Database Connection Pending:</strong> @Model.StatusMessage
</div>

<div class="alert alert-checklist">
    <div class="checklist-title">
        <span>📋</span>
        <span>What you need to complete in Step 06:</span>
    </div>
    <div class="checklist">
        <ol>
            <li>
                <strong>Initialize the SQLite database file:</strong>
                <pre><code>sqlite3 Data/staff.db &lt; resources/staff-sqlite.sql</code></pre>
            </li>
            <li>
                <strong>Install the EF Core SQLite NuGet package:</strong>
                <pre><code>dotnet add package Microsoft.EntityFrameworkCore.Sqlite</code></pre>
            </li>
            <li>
                <strong>Create the Entity Model (<code>Models/Staff.cs</code>):</strong>
                Define the <code>Staff</code> class mapping to the database table columns.
            </li>
            <li>
                <strong>Create the Database Context (<code>Data/ApplicationDbContext.cs</code>):</strong>
                Inherit from <code>DbContext</code> and declare <code>public DbSet&lt;Staff&gt; Staff { get; set; } = null!;</code>.
            </li>
            <li>
                <strong>Register the DbContext in <code>Program.cs</code>:</strong>
                Uncomment the <code>builder.Services.AddDbContext&lt;ApplicationDbContext&gt;(...)</code> service registration.
            </li>
            <li>
                <strong>Update this page (<code>Pages/Staff/Index.cshtml.cs</code> and <code>Pages/Staff/Index.cshtml</code>):</strong>
                Inject <code>ApplicationDbContext</code> into the constructor, execute <code>await _context.Staff.ToListAsync()</code> in <code>OnGetAsync()</code>, and render the employee table!
            </li>
        </ol>
    </div>
</div>

